{
  "name": "@trace/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc",
    "auth:generate": "pnpm dlx auth@latest generate --adapter drizzle --dialect postgresql --config src/modules/auth/auth.ts --output src/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "better-auth": "^1.7.6",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
